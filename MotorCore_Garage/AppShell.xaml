<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorCore_Garage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MotorCore_Garage.Pages"
    Title="MotorCore Garage"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource White}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}">

    <TabBar>
        <ShellContent Title="Inicio" Route="inicio" ContentTemplate="{DataTemplate pages:InicioPage}" />
        <ShellContent Title="Vehículos" Route="vehiculos" ContentTemplate="{DataTemplate pages:VehiculosPage}" />
        <ShellContent Title="Órdenes" Route="ordenes" ContentTemplate="{DataTemplate pages:OrdenesPage}" />
        <ShellContent Title="Alertas" Route="alertas" ContentTemplate="{DataTemplate pages:AlertasPage}" />
    </TabBar>
</Shell>
