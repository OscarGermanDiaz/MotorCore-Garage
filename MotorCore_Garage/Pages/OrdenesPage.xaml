<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.OrdenesPage"
             Title="Órdenes"
             Style="{StaticResource Pagina}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16">

            <Label Text="Taller Central" Style="{StaticResource Pie}" />
            <Label Text="Órdenes de trabajo" Style="{StaticResource Titulo}" />

            <Grid Padding="4" ColumnSpacing="0" BackgroundColor="{StaticResource Gray200}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BackgroundColor="{StaticResource White}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,8">
                    <Label Text="Abiertas" Style="{StaticResource CuerpoStrong}" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="En curso" Style="{StaticResource Pie}" TextColor="{StaticResource Gray950}" HorizontalOptions="Center" Margin="0,8" />
                <Label Grid.Column="2" Text="Cerradas" Style="{StaticResource Pie}" TextColor="{StaticResource Gray950}" HorizontalOptions="Center" Margin="0,8" />
            </Grid>

            <VerticalStackLayout x:Name="ListaOrdenes" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
