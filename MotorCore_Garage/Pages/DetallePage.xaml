<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.DetallePage"
             Title="Detalle"
             Style="{StaticResource Pagina}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16">

            <Label Text="‹ Volver" Style="{StaticResource CuerpoStrong}" TextColor="{StaticResource Primary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolver" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="{Binding Placa}" Style="{StaticResource Pie}" />
            <Label Text="{Binding Modelo}" Style="{StaticResource Titulo}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Km}" Style="{StaticResource Seccion}" FontSize="16" />
                        <Label Text="Kilómetros" Style="{StaticResource Pie}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Salud, StringFormat='{0}%'}" Style="{StaticResource Seccion}" FontSize="16" />
                        <Label Text="Salud" Style="{StaticResource Pie}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="800 km" Style="{StaticResource Seccion}" FontSize="16" />
                        <Label Text="Próx. servicio" Style="{StaticResource Pie}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Predicción de desgaste" Style="{StaticResource Seccion}" />
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout x:Name="ListaComponentes" Spacing="14" />
            </Border>

            <Border BackgroundColor="{StaticResource Secondary}" Style="{StaticResource Tarjeta}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Recomendación" Style="{StaticResource CuerpoStrong}" TextColor="{StaticResource Tertiary}" />
                    <Label Text="Programar revisión de frenos antes de 800 km para evitar fallas en ruta."
                           Style="{StaticResource Cuerpo}" TextColor="{StaticResource MidnightBlue}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Programar servicio" Style="{StaticResource BotonPrimario}" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
