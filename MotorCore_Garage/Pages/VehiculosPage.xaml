<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.VehiculosPage"
             Title="Vehículos"
             Style="{StaticResource Pagina}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16">

            <Label Text="Mi flota" Style="{StaticResource Pie}" />
            <Label Text="Vehículos" Style="{StaticResource Titulo}" />

            <Border Style="{StaticResource Tarjeta}" Padding="16,12">
                <Entry Placeholder="Buscar por placa o modelo" />
            </Border>

            <HorizontalStackLayout Spacing="8">
                <Border BackgroundColor="{StaticResource Primary}" Style="{StaticResource Chip}">
                    <Label Text="Todos" Style="{StaticResource Etiqueta}" TextColor="{StaticResource White}" />
                </Border>
                <Border BackgroundColor="{StaticResource Gray100}" Style="{StaticResource Chip}">
                    <Label Text="Atención" Style="{StaticResource Etiqueta}" />
                </Border>
                <Border BackgroundColor="{StaticResource Gray100}" Style="{StaticResource Chip}">
                    <Label Text="Al día" Style="{StaticResource Etiqueta}" />
                </Border>
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="ListaVehiculos" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
