<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.AlertasPage"
             Title="Alertas"
             Style="{StaticResource Pagina}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16">

            <Label Text="Predicciones" Style="{StaticResource Pie}" />
            <Label Text="Alertas" Style="{StaticResource Titulo}" />

            <VerticalStackLayout x:Name="ListaAlertas" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
