<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.InicioPage"
             Title="Inicio"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra superior con indicador de modo local -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Graphite}" Padding="16,44,16,12" ColumnDefinitions="*,Auto">
            <Label x:Name="Encabezado" Text="MotorCode Garage" Style="{StaticResource Seccion}" TextColor="{StaticResource White}" VerticalOptions="Center" />
            <Border Grid.Column="1" BackgroundColor="{StaticResource Card}" Style="{StaticResource Chip}" VerticalOptions="Center">
                <Label Text="☁ Modo local" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource Ink}" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,96" Spacing="16">

                <Label x:Name="Saludo" Style="{StaticResource Pie}" FontSize="14" />
                <Label x:Name="Fecha" Style="{StaticResource Titulo}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border Style="{StaticResource Tarjeta}" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Citas de hoy" Style="{StaticResource Etiqueta}" />
                            <Label x:Name="CitasHoy" Style="{StaticResource Titulo}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Vehículos en taller" Style="{StaticResource Etiqueta}" />
                            <Label x:Name="EnTaller" Style="{StaticResource Titulo}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Alertas urgentes" Style="{StaticResource Etiqueta}" />
                            <Label x:Name="Urgentes" Style="{StaticResource Titulo}" TextColor="{StaticResource WearDue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Bahías ocupadas" Style="{StaticResource Etiqueta}" />
                            <Label x:Name="Bahias" Style="{StaticResource Titulo}" />
                            <ProgressBar x:Name="BarraBahias" ProgressColor="{StaticResource Primary}" HeightRequest="8" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Próximas citas" Style="{StaticResource Seccion}" />
                <VerticalStackLayout x:Name="ListaCitas" Spacing="12" />

                <Label Text="Alertas de mantenimiento" Style="{StaticResource Seccion}" />
                <VerticalStackLayout x:Name="ListaAlertas" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Text="+" FontSize="28" FontFamily="OpenSansSemibold"
                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}"
                CornerRadius="16" WidthRequest="56" HeightRequest="56" Padding="0"
                HorizontalOptions="End" VerticalOptions="End" Margin="16"
                Clicked="OnFab" />

        <Border Grid.Row="1" x:Name="Snack" IsVisible="False" BackgroundColor="{StaticResource Graphite}"
                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,12"
                Margin="16" VerticalOptions="End">
            <Label x:Name="SnackTexto" TextColor="{StaticResource White}" FontSize="14" />
        </Border>
    </Grid>
</ContentPage>
